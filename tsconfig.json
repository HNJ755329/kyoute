{
  "compilerOptions": {
    "target": "ES2020",           // 出力するJSのバージョン
    "module": "commonjs",         // モジュールシステム
    "outDir": "./dist",           // 出力先ディレクトリ
    "rootDir": "./src",           // ソースディレクトリ
    "strict": true,               // 厳格な型チェック
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
